# ============================================================
# robyajo-portfolio — environment variables
# Copy ke .env.local untuk development lokal:
#   cp .env.example .env.local
# Di Vercel: Project Settings > Environment Variables.
# ============================================================

# ---------- Database (Neon Postgres) ----------
# OPSIONAL untuk boot/build — tanpa ini site tetap jalan, tapi
# guestbook, komentar/like blog, /projects (dari DB), dan shortlink
# tampil kosong. Wajib jika fitur tulis/baca DB dipakai.
# Dapatkan gratis di https://neon.tech lalu jalankan: pnpm db:migrate
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Salt rahasia untuk hash IP anonim (reactions, view counts, anti-spam).
# Wajib diisi string acak panjang jika fitur engagement dipakai.
# Tanpa ini, hashIp() melempar error (ditangkap safeQuery -> fallback).
IP_HASH_SALT=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ---------- Auth (Clerk) ----------
# OPSIONAL — tanpa ini site tampil signed-out: tombol sign-in hilang,
# guestbook/komentar read-only, /admin redirect ke home.
# Daftar di https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# User ID pemilik = kekuatan admin. Lihat di Clerk Dashboard > Users.
OWNER_CLERK_USER_ID=user_...
# Clerk > Webhooks > Signing Secret. Endpoint: /api/webhooks/clerk
# (membersihkan data user saat akun Clerk dihapus).
CLERK_WEBHOOK_SECRET=whsec_...

# ---------- Spotify ----------
# OPSIONAL — tanpa ini widget now-playing tampil diam (tidak error).
# Jalankan sekali: pnpm spotify:token
# (daftarkan http://127.0.0.1:3000 sebagai redirect URI di dashboard Spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ---------- Integrasi opsional ----------
# Menaikkan rate-limit GitHub API (kartu repo/profil, kartu /svg GitHub).
GITHUB_TOKEN=ghp_...
# Hanya untuk kartu /svg?type=activity&source=wakatime|both
WAKATIME_API_KEY=waka_...
# Analytics Umami (hanya dimuat di production). Kosongkan = nonaktif.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Domain kedua khusus shortlink (mis. tautan pendek pribadi).
# Kosongkan = shortlink hanya di domain utama.
SHORTLINK_DOMAIN=
NEXT_PUBLIC_SHORTLINK_DOMAIN=

# ---------- URL & base ----------
# Override canonical URL. Kosongkan = ikut URL produksi Vercel,
# lalu http://localhost:3000 saat dev lokal.
NEXT_PUBLIC_BASE_URL=https://ajoroby.is-a.dev

# ---------- Otomatis oleh Vercel (JANGAN diisi manual) ----------
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL
# VERCEL_DEPLOYMENT_ID
# NODE_ENV
