# ==============================================================================
# Portofolio Roby — Contoh Environment Variables
# Salin berkas ini ke `.env.local` untuk pengembangan lokal:
#   cp .env.example .env.local
# ==============================================================================

# ---------- Database (Neon PostgreSQL) ----------
# Diperlukan untuk menyimpan analitik pengunjung, komentar, data shortlink,
# dan pengaturan dinamis model AI (/admin/models).
DATABASE_URL=postgresql://neondb_owner:password@ep-contoh-pooler.ap-southeast-1.aws.neon.tech/db_ajoroby?sslmode=require

# ---------- Autentikasi Admin (NextAuth.js) ----------
# Rahasia sesi NextAuth. Buat string acak (mis. `openssl rand -base64 32`).
NEXTAUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NEXTAUTH_URL=http://localhost:3000

# Kredensial OAuth Google (opsional jika hanya login akun admin lokal).
GOOGLE_ID=
GOOGLE_SECRET=

# Salt pengacak IP pengunjung untuk perlindungan privasi.
IP_HASH_SALT=ganti-dengan-string-acak-minimal-16-karakter

# ---------- Kredensial Pengelola (Admin Credentials Auth) ----------
# Dipakai untuk membuat akun admin awal di database via halaman registrasi pertama.
ADMIN_INVITE_CODE=

# ---------- GitHub Integration ----------
# Token akses GitHub pribadi (PAT) untuk membaca commit, repositori, dan rilis.
GITHUB_TOKEN=

# ---------- Analisis & Metrik (Opsional) ----------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
SHORTLINK_DOMAIN=
NEXT_PUBLIC_SHORTLINK_DOMAIN=

# ---------- URL & Base ----------
NEXT_PUBLIC_BASE_URL=https://ajoroby.is-a.dev

# ---------- AI Gateways (Hanya URL & Kredensial Provider) ----------
# Catatan: Pemilihan model chatbot & blog, thinking mode, temperature, dan parameter
# lainnya sepenuhnya diatur dari database lewat Admin Panel (/admin/models).

# 1. Cloudflare AI Gateway
CF_GATEWAY_URL=https://er-ai-gateway.duckdns.org/v1
CF_GATEWAY_API_KEY=

# 2. AI Gateway Bersama (er-ai-rest)
LLM_BASE_URL=https://er-ai-api.mooo.com
AGY_API_KEY=
LLM_API_KEY=
LLAMA_API_KEY=
GEMINI_API_KEY=

# ---------- Panel Tulis Artikel (Admin) ----------
BLOG_ADMIN_TOKEN=

# ---------- Kunci Proyek Sinkronisasi Aktivitas ----------
ACTIVITY_PROJECT_KEYS=pk_contoh:Contoh Proyek
