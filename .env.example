# ============================================================
# robyajo-portfolio — environment variables
# Copy ke .env.local untuk development lokal:
#   cp .env.example .env.local
# Di Vercel: Project Settings > Environment Variables.
# ============================================================

# ---------- Database (Neon Postgres) ----------
# OPSIONAL untuk boot/build — tanpa ini site tetap jalan, tapi
# guestbook, komentar/like blog, /projects (dari DB), dan shortlink
# tampil kosong. Wajib jika fitur tulis/baca DB dipakai.
# Dapatkan gratis di https://neon.tech lalu jalankan: pnpm db:migrate
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Salt rahasia untuk hash IP anonim (reactions, view counts, anti-spam).
# Wajib diisi string acak panjang jika fitur engagement dipakai.
# Tanpa ini, hashIp() melempar error (ditangkap safeQuery -> fallback).
IP_HASH_SALT=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ---------- Auth (NextAuth / Auth.js v4, OAuth langsung) ----------
# Secret sesi. Wajib ada (acak panjang). Buat: openssl rand -hex 32
NEXTAUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# URL situs (WAJIB benar di production agar callback OAuth valid).
# Lokal: http://localhost:3000 ; produksi: https://ajoroby.is-a.dev
NEXTAUTH_URL=http://localhost:3000
# OAuth providers — isi salah satu atau keduanya, lalu daftarkan
# callback URL {NEXTAUTH_URL}/api/auth/callback/<github|google> di dashboard provider.
# GitHub: Settings > Developer settings > OAuth Apps
# GITHUB_ID=
# GITHUB_SECRET=
# Google: console.cloud.google.com > APIs & Services > Credentials
# GOOGLE_ID=
# GOOGLE_SECRET=
# ID user pemilik = kekuatan admin. Isi subject ID OAuth setelah login pertama
# (lihat log server / halaman debug sesi), contoh format GitHub: angka, Google: angka panjang.
# OWNER_USER_ID=

# ---------- Activity sync (kegiatan antar-proyek) ----------
# Registry kunci proyek: "kunci:Nama Tampil,kunci2:Nama 2".
# Pengirim wajib menyertakan header X-project berisi kunci valid.
# Buat kunci: openssl rand -hex 16 (beri awalan pk_).
ACTIVITY_PROJECT_KEYS=pk_contoh:Contoh Proyek

# ---------- Integrasi opsional ----------
# Menaikkan rate-limit GitHub API (kartu repo/profil, kartu /svg GitHub).
GITHUB_TOKEN=ghp_...
# Hanya untuk kartu /svg?type=activity&source=wakatime|both
WAKATIME_API_KEY=waka_...
# Analytics Umami (hanya dimuat di production). Kosongkan = nonaktif.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Domain kedua khusus shortlink (mis. tautan pendek pribadi).
# Kosongkan = shortlink hanya di domain utama.
SHORTLINK_DOMAIN=
NEXT_PUBLIC_SHORTLINK_DOMAIN=

# ---------- Penulis otomatis blog (GitHub Actions) ----------
# Kunci Google AI Studio (aistudio.google.com/apikey). Dipakai skrip
# scripts/blog-autopilot.ts untuk menulis artikel harian. Simpan juga sebagai
# rahasia repo: GEMINI_API_KEY, plus ACTIVITY_PROJECT_KEYS bila ingin
# sinkronisasi catatan rilis otomatis.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# ---------- Panel tulis artikel (admin) ----------
# Token GitHub ber-izin Contents: Read and write pada repo ini. Artikel
# disimpan sebagai berkas MDX, jadi menyimpan dari panel admin = commit ke
# repo (Vercel lalu menerbitkan ulang situs ±1–2 menit).
# Kosong -> panel memakai GITHUB_TOKEN di atas. Di lokal tanpa token,
# set BLOG_WRITE_MODE=file agar berkas ditulis langsung ke disk.
BLOG_ADMIN_TOKEN=
# BLOG_WRITE_MODE=file
# BLOG_GITHUB_REPO=robyajo/robyajo-portfolio
# BLOG_GITHUB_BRANCH=master

# ---------- URL & base ----------
# Override canonical URL. Kosongkan = ikut URL produksi Vercel,
# lalu http://localhost:3000 saat dev lokal.
NEXT_PUBLIC_BASE_URL=https://ajoroby.is-a.dev

# ---------- Otomatis oleh Vercel (JANGAN diisi manual) ----------
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL
# VERCEL_DEPLOYMENT_ID
# NODE_ENV

ACTIVITY_PROJECT_KEYS=pk_contoh:Contoh Proyek
